#!/usr/bin/env python3
"""
/odom_combined (nav_msgs/Odometry) → /odom_debug (navi_bringup/OdomDebug)
提取 x, y, yaw (yaw 由四元数 z, w 计算: 2*atan2(z, w))
"""

import math
import rclpy
from rclpy.node import Node
from nav_msgs.msg import Odometry
from navi_bringup.msg import OdomDebug


class OdomDebugPublisher(Node):
    def __init__(self):
        super().__init__("odom_debug_publisher")
        self.sub = self.create_subscription(Odometry, "/odom_combined", self.callback, 10)
        self.pub = self.create_publisher(OdomDebug, "/odom_debug", 10)
        self.get_logger().info("odom_debug_publisher ready (/odom_combined → /odom_debug)")

    def callback(self, msg: Odometry):
        out = OdomDebug()
        out.x = msg.pose.pose.position.x
        out.y = msg.pose.pose.position.y

        q = msg.pose.pose.orientation
        out.yaw = 2.0 * math.atan2(q.z, q.w) * 180.0 / math.pi

        self.pub.publish(out)


def main():
    rclpy.init()
    node = OdomDebugPublisher()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()


if __name__ == "__main__":
    main()
